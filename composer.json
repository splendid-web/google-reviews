{
  "name": "splendidweb/craft-google-reviews",
  "description": "Sync and display Google reviews in Craft CMS 5 (Places + Business Profile).",
  "type": "craft-plugin",
  "license": "proprietary",
  "authors": [
    {
      "name": "Splendid Web",
      "homepage": "https://splendidweb.co.uk"
    }
  ],
  "support": {
    "email": "admin@splendidweb.co.uk",
    "issues": "https://github.com/splendid-web/google-reviews/issues?state=open",
    "source": "https://github.com/splendid-web/google-reviews",
    "docs": "https://github.com/splendid-web/google-reviews/blob/master/README.md"
  },
  "require": {
    "craftcms/cms": "^5.3.0"
  },
  "autoload": {
    "psr-4": {
      "splendidweb\\googlereviews\\": "src/"
    }
  },
  "extra": {
    "name": "Google Reviews",
    "handle": "google-reviews",
    "class": "splendidweb\\googlereviews\\Plugin",
    "description": "Sync Google Places or Business Profile reviews into Craft and render from stored data."
  }
}
