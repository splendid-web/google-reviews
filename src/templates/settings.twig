{% import "_includes/forms" as forms %}
{% set oauthConnectUrl = actionUrl('google-reviews/oauth/start', {
    return: cpUrl('settings/plugins/google-reviews')
}) %}
{% set oauthTestUrl = actionUrl('google-reviews/oauth/test', {
    return: cpUrl('settings/plugins/google-reviews')
}) %}

{{ forms.lightswitchField({
    label: "Enable Sync",
    id: "enabled",
    name: "enabled",
    width: "25%",
    on: settings.enabled
}) }}

{{ forms.selectField({
    label: "Review Source Mode",
    instructions: "Choose where reviews are synced from. Mock mode is best for local testing.",
    id: "syncSourceMode",
    name: "syncSourceMode",
    value: settings.syncSourceMode,
    options: [
        { label: "Mock Data", value: "mock" },
        { label: "Places API", value: "places" },
        { label: "Business Profile API", value: "businessProfile" }
    ]
}) }}

{{ forms.autosuggestField({
    label: "Places API Key",
    instructions: "Google Maps Places API key (used when Places mode is enabled).",
    id: "placesApiKey",
    name: "placesApiKey",
    value: settings.placesApiKey,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "Places API Place ID",
    instructions: "Google Place ID for the business location (used when Places API mode is enabled).",
    id: "placesPlaceId",
    name: "placesPlaceId",
    value: settings.placesPlaceId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "GBP API Account ID",
    instructions: "Google Business Profile account identifier. Env values supported.",
    id: "googleAccountId",
    name: "googleAccountId",
    value: settings.googleAccountId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "GBP API Location ID",
    instructions: "Google Business Profile location identifier. Env values supported.",
    id: "googleLocationId",
    name: "googleLocationId",
    value: settings.googleLocationId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "GBP API OAuth Client ID",
    instructions: "OAuth client ID used for Google Business Profile token refresh. Env values supported.",
    id: "oauthClientId",
    name: "oauthClientId",
    value: settings.oauthClientId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "GBP API OAuth Client Secret",
    instructions: "OAuth client secret used for Google Business Profile token refresh. Env values supported.",
    id: "oauthClientSecret",
    name: "oauthClientSecret",
    value: settings.oauthClientSecret,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "GBP API OAuth Refresh Token",
    instructions: "Long-lived refresh token for Google Business Profile server-side sync. Env values supported.",
    id: "oauthRefreshToken",
    name: "oauthRefreshToken",
    value: settings.oauthRefreshToken,
    suggestEnvVars: true
}) }}

<div class="field">
    <div class="heading">
        <label>GBP API OAuth Connect</label>
        <div class="instructions">
            <p>Use this to authorize Google and mint a refresh token for this OAuth client. Add <code>{{ actionUrl('google-reviews/oauth/callback') }}</code> to your Google OAuth Client authorized redirect URIs.</p>
        </div>
    </div>
    <div class="input ltr">
        <a class="btn" href="{{ oauthConnectUrl }}">Connect Google Business Profile</a>
        <a class="btn" href="{{ oauthTestUrl }}">Test OAuth Credentials</a>
    </div>
</div>

{{ forms.textField({
    label: "Max Reviews",
    id: "maxReviews",
    name: "maxReviews",
    type: "number",
    min: 1,
    max: 500,
    value: settings.maxReviews
}) }}

{{ forms.textField({
    label: "Minimum Rating (optional)",
    id: "minimumRating",
    name: "minimumRating",
    type: "number",
    min: 1,
    max: 5,
    value: settings.minimumRating
}) }}

