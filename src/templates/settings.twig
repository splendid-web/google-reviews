{% import "_includes/forms" as forms %}

{{ forms.lightswitchField({
    label: "Enable Sync",
    id: "enabled",
    name: "enabled",
    width: "25%",
    on: settings.enabled
}) }}

{{ forms.lightswitchField({
    label: "Use Mock Data",
    instructions: "Enable for local testing without Google API credentials.",
    id: "useMockData",
    name: "useMockData",
    on: settings.useMockData
}) }}

{{ forms.lightswitchField({
    label: "Use Places API (Hybrid Mode)",
    instructions: "Use Places API key + Place ID instead of Business Profile OAuth flow.",
    id: "usePlacesApi",
    name: "usePlacesApi",
    on: settings.usePlacesApi
}) }}

{{ forms.autosuggestField({
    label: "Places API Key",
    instructions: "Google Maps Places API key (used when Places mode is enabled).",
    id: "placesApiKey",
    name: "placesApiKey",
    value: settings.placesApiKey,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "Place ID",
    instructions: "Google Place ID for the business location (used when Places mode is enabled).",
    id: "placesPlaceId",
    name: "placesPlaceId",
    value: settings.placesPlaceId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "Google Account ID",
    instructions: "Business Profile account identifier. Env values supported.",
    id: "googleAccountId",
    name: "googleAccountId",
    value: settings.googleAccountId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "Google Location ID",
    instructions: "Business Profile location identifier. Env values supported.",
    id: "googleLocationId",
    name: "googleLocationId",
    value: settings.googleLocationId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "OAuth Client ID",
    instructions: "OAuth client ID used to refresh access tokens. Env values supported.",
    id: "oauthClientId",
    name: "oauthClientId",
    value: settings.oauthClientId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "OAuth Client Secret",
    instructions: "OAuth client secret used to refresh access tokens. Env values supported.",
    id: "oauthClientSecret",
    name: "oauthClientSecret",
    value: settings.oauthClientSecret,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: "OAuth Refresh Token",
    instructions: "Long-lived refresh token for server-side sync. Env values supported.",
    id: "oauthRefreshToken",
    name: "oauthRefreshToken",
    value: settings.oauthRefreshToken,
    suggestEnvVars: true
}) }}

{{ forms.textField({
    label: "Max Reviews",
    id: "maxReviews",
    name: "maxReviews",
    type: "number",
    min: 1,
    max: 500,
    value: settings.maxReviews
}) }}

{{ forms.textField({
    label: "Minimum Rating (optional)",
    id: "minimumRating",
    name: "minimumRating",
    type: "number",
    min: 1,
    max: 5,
    value: settings.minimumRating
}) }}

